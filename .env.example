# ── Lidarr ───────────────────────────────────────────────
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=changeme
# Optional: used only when adding a brand-new artist to Lidarr.
# If unset, manualarr picks the first root folder / default profiles from Lidarr.
LIDARR_ROOT_FOLDER=
LIDARR_QUALITY_PROFILE_ID=
LIDARR_METADATA_PROFILE_ID=

# ── Library filesystem (mount the same NFS share Lidarr/Navidrome use) ──
# Final music library root, as seen INSIDE this container.
MUSIC_LIBRARY_PATH=/music
# Temp area for in-progress uploads.
STAGING_PATH=/staging
# Stale staging dirs older than this (hours) are swept on the next upload.
STAGING_TTL_HOURS=24
# Folder layout. Tokens: {artist} {album} {year} {track} {title} {ext}
ALBUM_FOLDER_FORMAT=({year}) {album}
TRACK_FILE_FORMAT={track} {title}.{ext}

# ── Navidrome (optional — triggers a rescan after ingest) ──
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASS=
